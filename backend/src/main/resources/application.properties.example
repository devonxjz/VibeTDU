# ===================================================================
# Virtual Chemistry Lab – Application Configuration (TEMPLATE)
# ===================================================================
# Copy this file to application.properties and fill in real values.
# NEVER commit application.properties with real secrets!

# --- Server ---
server.port=8080

# --- Supabase PostgreSQL DataSource ---
spring.datasource.driver-class-name=org.postgresql.Driver
spring.sql.init.mode=always

# Supabase API Keys
app.supabase.url=YOUR_SUPABASE_URL
app.supabase.anon-key=YOUR_SUPABASE_ANON_KEY
app.supabase.publishable-key=YOUR_SUPABASE_PUBLISHABLE_KEY

# --- JPA / Hibernate ---
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.boot.allow_jdbc_metadata_access=false

# --- Jackson ---
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.default-property-inclusion=non_null

# --- AI Client ---
app.ai.api-keys[0]=YOUR_AI_API_KEY
app.ai.api-url=https://api.groq.com/openai/v1/chat/completions
app.ai.model=llama-3.3-70b-versatile
app.ai.mock-mode=true

# --- CORS ---
app.cors.allowed-origins=*

# --- Rate Limit ---
app.rate-limit.mix-cooldown-ms=2000

# --- Authentication ---
app.auth.google.client-id=YOUR_GOOGLE_CLIENT_ID
app.auth.jwt.secret=YOUR_JWT_SECRET_MIN_32_CHARS

# --- External Chemical APIs ---
app.pubchem.base-url=https://pubchem.ncbi.nlm.nih.gov/rest/pug
app.cactus.base-url=https://cactus.nci.nih.gov/chemical/structure
app.opsin.base-url=https://opsin.ch.cam.ac.uk

# --- SpringDoc OpenAPI ---
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method
springdoc.swagger-ui.tagsSorter=alpha
springdoc.swagger-ui.tryItOutEnabled=true
springdoc.swagger-ui.filter=true
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.displayRequestDuration=true
springdoc.swagger-ui.defaultModelsExpandDepth=2
springdoc.swagger-ui.defaultModelExpandDepth=3
